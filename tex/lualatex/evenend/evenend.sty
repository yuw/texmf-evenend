%% ---------------------------------------------------------------------
%% レジスタとフラグ
\newcount\evenend@N        \evenend@N=2
\newcount\evenend@initN    % 読み込み時の段数（\twocolumnで戻る）
\newcount\evenend@nextN    % \evenendcolumnsで切り換える先の段数
\newcount\evenend@colno    % 現在のページで出力済みの段数
\newcount\evenend@status   % Luaからの返り値
\newdimen\evenend@ruleht
\newdimen\evenend@height   % 揃えた段の見かけの下端
\newdimen\evenend@colboxht % 段の箱の高さ
\newdimen\evenend@rowht    % 揃えた段組の高さ（下に置く段抜きフロートを含む）
\newdimen\evenend@baseline % 揃えた段組の最終行のベースライン
\newdimen\evenend@pagecolht % このページの段組が始まるときの段の高さ（行の位置の基準）
\newdimen\evenend@dblbotadj % 版面下端に予約された段抜きフロートの分（\@colhtに戻す）
\newdimen\evenend@colsep   % いまの段組の段間
\newdimen\evenend@colrule  % いまの段組の段間罫の太さ
\newdimen\evenend@nextsep  % 次の段組の段間
\newdimen\evenend@nextrule % 次の段組の段間罫の太さ
\newdimen\evenend@headshift % headingskip=block：段組の上に足すアキ（見出しの上アキの分）
\newbox\evenend@pagetop    % このページで確定した段組（ブロック）の並び
\newbox\evenend@scratch
\newbox\evenend@topfigbox
\newbox\evenend@botfigbox
\newbox\evenend@fnrulebox
\newbox\evenend@colbox
\newbox\evenend@loosebox  % 1段の段組の中身（箱に詰めずに積む．Lua側で組む）
\newcount\evenend@loosestatus % 1ならloosebox がある
\newif\ifevenend@loosepage % このページに中身のまま積んだ段組がある
\newif\ifevenend@loosemerged % \@outputboxに積んだブロックをまとめて詰めた
\newattribute\evenend@fnattr
%% footnote=page：脚注を版面の全幅で版面の下端に置く（multicolと同じ）
\newskip\evenend@topskip    % 最後に見た0でない\topskip（箱の中で0になったときに使う）
\newdimen\evenend@maxdepth  % 同じく\maxdepth
\newskip\evenend@fnskip     % クラスの\skip\footins（段を組むあいだは見込みのために変える）
\newcount\evenend@fncount   % クラスの\count\footins
\newbox\evenend@pagefn      % このページの脚注（全幅）
\newdimen\evenend@pagefnspace % その領域の高さ（\@colhtから除いた分）
\newbox\evenend@pushbox     % 組み直したページに入り切らず，次のページへ送り返す本文
\newdimen\evenend@fnsmd     % 脚注の\splitmaxdepth
\newbox\evenend@textbottombox
\newdimen\evenend@rowdp     % 組んだ段組の行（\@outputbox）の最終行のベースラインより下の分

\newif\ifevenend@enabled   \evenend@enabledtrue
\newif\ifevenend@final     % 次に出力される本文段が最終ページのもの
\newif\ifevenend@lastcol   % この段が最終ページの最後の本文段
\newif\ifevenend@captured  % 直前の段を取り込んだ
\newif\ifevenend@pagebad   % 取り込めなかった段（フロートだけの段など）がある
\newif\ifevenend@colmode   % 脚注を段の下端に置く
\newif\ifevenend@debug
\newif\ifevenend@onecolumn \evenend@onecolumntrue % \onecolumnの前でも揃える
\newif\ifevenend@switch    % 段数の切り換えを待っている
\newif\ifevenend@floatgrid \evenend@floatgridtrue % フロートの並びを行送りの倍数にする
\newif\ifevenend@headblock % 見出しの上アキを段組の間のアキに含める
\newif\ifevenend@spanfnbottom % spanfootnote=bottom
\newif\ifevenend@sfb        % spanfootnote=bottomが効く（footnote=columnのときだけ）
\newif\ifevenend@pagehasfn  % このページにもう脚注がある
\newif\ifevenend@fixed      % ページを組み直す（footnote=page）

%% ---------------------------------------------------------------------
%% オプション
\def\evenend@s@page{page}
\def\evenend@s@column{column}
\def\evenend@s@block{block}
\def\evenend@s@above{above}
\def\evenend@s@bottom{bottom}
\def\evenend@s@summary{summary}
\def\evenend@s@none{none}
%% gridreport：floatgridが効かないページ（LaTeXが組んだページ）でフロートの後の行が
%% 行送りの位置からずれたとき，0：何も出さない，1：文書末に一覧を警告（既定），
%% 2：ページごとに情報をログに書く
\def\evenend@gridreport{1}
\def\evenend@gridpages{}
\newcount\evenend@gridflag
\DeclareKeys[evenend]{
  columns.code     = {\evenend@N=\numexpr#1\relax
                      \ifnum\evenend@N<\@ne
                        \PackageError{evenend}{columns must be positive}{}%
                        \evenend@N=\tw@
                      \fi},
  columns.usage    = load,
  footnote.code    = {\edef\evenend@tmp{#1}%
                      \ifx\evenend@tmp\evenend@s@page
                        \evenend@colmodefalse
                      \else\ifx\evenend@tmp\evenend@s@column
                        \evenend@colmodetrue
                      \else
                        \PackageError{evenend}{Unknown value `#1' for
                          footnote}{Use `page' or `column'.}%
                      \fi\fi},
  footnote.usage   = general,
  debug.if         = evenend@debug,
  enable.if        = evenend@enabled,
  onecolumn.if     = evenend@onecolumn,
  floatgrid.if     = evenend@floatgrid,
  gridreport.code  = {\edef\evenend@tmp{#1}%
                      \ifx\evenend@tmp\evenend@s@summary
                        \def\evenend@gridreport{1}%
                      \else\ifx\evenend@tmp\evenend@s@page
                        \def\evenend@gridreport{2}%
                      \else\ifx\evenend@tmp\evenend@s@none
                        \def\evenend@gridreport{0}%
                      \else
                        \PackageError{evenend}{Unknown value `#1' for
                          gridreport}{Use `summary', `page' or `none'.}%
                      \fi\fi\fi},
  gridreport.usage = general,
  blockskip.code   = {\def\evenend@blockskip{#1}},
  blockgap.code    = {\def\evenend@blockgap{#1}},
  blockgap.usage   = general,
  blockskip.usage  = general,
  blockmin.code    = {\def\evenend@blockmin{#1}},
  blockmin.usage   = general,
  headingskip.code = {\edef\evenend@tmp{#1}%
                      \ifx\evenend@tmp\evenend@s@column
                        \evenend@headblockfalse
                      \else\ifx\evenend@tmp\evenend@s@block
                        \evenend@headblocktrue
                      \else
                        \PackageError{evenend}{Unknown value `#1' for
                          headingskip}{Use `column' or `block'.}%
                      \fi\fi},
  headingskip.usage = general,
  spanfootnote.code = {\edef\evenend@tmp{#1}%
                      \ifx\evenend@tmp\evenend@s@above
                        \evenend@spanfnbottomfalse
                      \else\ifx\evenend@tmp\evenend@s@bottom
                        \evenend@spanfnbottomtrue
                      \else
                        \PackageError{evenend}{Unknown value `#1' for
                          spanfootnote}{Use `above' or `bottom'.}%
                      \fi\fi},
  spanfootnote.usage = general,
}
%% 段組を切り換えたときの，前の段組の最終行から次の段組の1行目までのベースライン間
\def\evenend@blockskip{2\baselineskip}
%% 段組を切り換えたときの，前の段組の下端から次の段組の上端（1行目の\topskipの上）までの
%% アキ．空でなければblockskipの代わりに使う（multicolの\multicolsepと同じ測り方）
\def\evenend@blockgap{}
%% 段数を切り換えた後の残りの高さがこれより小さければ，そこで改ページする
\def\evenend@blockmin{5\baselineskip}
%% multicols環境を始めるときの残りの高さの下限（\premulticols．空なら\evenend@blockmin）
\let\evenend@mcpremin\@empty
\newdimen\evenend@lastgap
\ProcessKeyOptions[evenend]
\evenend@initN=\evenend@N

\newcommand\evenendsetup[1]{\SetKeys[evenend]{#1}\evenend@setsfb\evenend@fnreserve}
\def\evenend@setsfb{%
  \global\evenend@sfbfalse
  \ifevenend@colmode \ifevenend@spanfnbottom \global\evenend@sfbtrue \fi \fi}
\evenend@setsfb

%% 分割できる箱（tcolorboxのbreakable）の印：箱の番号と，部分の番号（Lua側で付ける）
\newattribute\evenend@boxattr
\newattribute\evenend@partattr
%% 段組の環境の後に置く目印（空の箱）の印
\newattribute\evenend@markattr

\directlua{
  require('evenend')
  evenend.setattr(luatexbase.attributes['evenend@fnattr'])
  evenend.setboxattr(luatexbase.attributes['evenend@boxattr'],
                     luatexbase.attributes['evenend@partattr'])
  evenend.setmarkattr(luatexbase.attributes['evenend@markattr'])
}

%% ---------------------------------------------------------------------
%% ユーザー命令
\newcommand\evenend{\global\evenend@enabledtrue}
\newcommand\raggedend{\global\evenend@enabledfalse}
%% 現在のページを揃えてから改ページする
%% 段落を閉じて本文をすべてページに送ってからフラグを立てる
%% （最後の段落で段があふれたときの出力を最終段と取り違えないため）
\newcommand\evenendclearpage{%
  \par
  \if@twocolumn \global\evenend@finaltrue \fi
  \clearpage}

%% \onecolumnで段組を終えるときも揃える
\AddToHook{cmd/onecolumn/before}{%
  \ifevenend@enabled \ifevenend@onecolumn \if@twocolumn
    \par \global\evenend@finaltrue
  \fi \fi \fi}

%% 確定したブロックを積んだままページが空で\clearpageになると，出力ルーチンが
%% 呼ばれずブロックが出力されないので，空の箱を置いて出力させる（空の箱は
%% Lua側で捨てる）
\AddToHook{cmd/clearpage/before}{%
  \if@twocolumn \ifvmode \ifvoid\evenend@pagetop\else
    \ifdim\pagegoal=\maxdimen \ifnum\evenend@colno=\z@
      \nointerlineskip\vbox{}%
    \fi \fi
    %% \clearpageは\@dbltopnum=-1で\pagetotal<\topskipなら\hbox{}を置くが，積んだ
    %% 段組は\pagetotalに入らないので，ページの材料があっても置かれてしまう（最後の
    %% 1段の末尾に空の行が加わる）．積んだ段組があるときは置かせない
    \ifnum\@dbltopnum=\m@ne \global\@dbltopnum\z@ \fi
  \fi \fi \fi}

%% LaTeXの\@doclearpageは，ページの中身を高さ0に\vsplitしてマークなどを取り出し，
%% 分けた箱は捨てる．ページが上の空の箱だけのとき，捨てる箱に\topskipの分の
%% Overfullの警告が出るので，この\vsplitでは警告を出さない
\ExplSyntaxOn
\AtBeginDocument
  {
    \tl_if_in:NnT \@doclearpage { \setbox \@tempboxa \vsplit \@cclv to \z@ }
      {
        \tl_replace_once:Nnn \@doclearpage
          { \setbox \@tempboxa \vsplit \@cclv to \z@ } { \evenend@vsplitzero }
      }
  }
\ExplSyntaxOff
\def\evenend@vsplitzero{%
  \edef\evenend@vfuzz{\number\vfuzz}%
  \vfuzz\maxdimen
  \setbox\@tempboxa\vsplit\@cclv to\z@
  \vfuzz\evenend@vfuzz sp\relax}

\AddToHook{enddocument}{%
  \ifevenend@enabled \if@twocolumn \par \global\evenend@finaltrue \fi \fi}
%% LaTeXが組んだ段のままページを出すとき，floatgridが効かずフロートの後の行が
%% 行送りの位置からずれていれば記録する（gridreport）
\def\evenend@gridbadpage{%
  \ifnum\evenend@gridreport=\tw@
    \PackageInfo{evenend}{Page \thepage: lines after floats are off the\MessageBreak
      line grid (floatgrid does not apply to this page)}%
  \fi
  \protected@xdef\evenend@gridpages{\ifx\evenend@gridpages\@empty\else\evenend@gridpages, \fi\thepage}}
\AddToHook{enddocument/afterlastpage}{%
  \ifnum\evenend@gridreport=\@ne \ifx\evenend@gridpages\@empty\else
    \PackageWarningNoLine{evenend}{floatgrid does not apply to page(s)
      \evenend@gridpages;\MessageBreak lines after floats are off the line grid.\MessageBreak
      Use footnote=page, or gyoudori with the float option}%
  \fi\fi}

%% ---------------------------------------------------------------------
%% N段組
%% 段組ごとの段間と段間罫：段組を始めるときに決め，その段組の間は変えない
%% （\evenendcolumnsの省略可能な引数で指定しなければ，そのときの\columnsepと
%% \columnseprule）
\def\evenend@takesep{%
  \global\evenend@colsep\columnsep
  \global\evenend@colrule\columnseprule
  \global\evenend@nextsep\columnsep
  \global\evenend@nextrule\columnseprule}
\def\evenend@setwidth{%
  \global\columnwidth\textwidth
  \global\advance\columnwidth -\numexpr\evenend@N-\@ne\relax\evenend@colsep
  \global\divide\columnwidth\evenend@N
  \global\hsize\columnwidth
  \global\linewidth\columnwidth}

%% \twocolumnは読み込み時の段数で段組を始める
\def\twocolumn{%
  \clearpage
  \global\evenend@N\evenend@initN
  \evenend@takesep
  \evenend@setwidth
  \global\@twocolumntrue
  \global\@firstcolumntrue
  \global\evenend@colno\z@
  \global\col@number\evenend@N
  \evenend@fnreserve
  \@ifnextchar[\@topnewpage\@floatplacement}
\AddToHook{cmd/onecolumn/after}{\evenend@fnreserve}
\AtBeginDocument{%
  \evenend@takesep
  \if@twocolumn
    \evenend@setwidth
    \global\col@number\evenend@N
  \fi}

%% ---------------------------------------------------------------------
%% 段数の切り換え：ここまでのこのページの段組を揃えて確定し（ブロック），
%% その下に新しい段数で段組を続ける
%% \evenendcolumns*はブロックを揃えずに（LaTeXの組み方のまま）確定する
\newif\ifevenend@nobalance
\newif\ifevenend@dobalance
%% \evenendcolumns[段間などの指定]{段数}．*付きでは，ここまでの段組を揃えない
\NewDocumentCommand\evenendcolumns{s O{} m}{%
  \IfBooleanTF{#1}{\global\evenend@nobalancetrue}{\global\evenend@nobalancefalse}%
  \global\evenend@nextsep\columnsep
  \global\evenend@nextrule\columnseprule
  \SetKeys[evenend/block]{#2}%
  \evenend@columns{#3}}
%% 次の段組だけの段間と段間罫
\DeclareKeys[evenend/block]{
  columnsep.code     = {\global\evenend@nextsep=\dimexpr#1\relax},
  columnseprule.code = {\global\evenend@nextrule=\dimexpr#1\relax},
}
\def\evenend@columns#1{%
  \par
  \ifinner
    \PackageError{evenend}{\string\evenendcolumns\space cannot be used in a box}{Use
      the environment `evenendmulticols' (or `multicols') in a box.}%
  \else\if@twocolumn
    \global\evenend@nextN=\numexpr#1\relax
    \ifnum\evenend@nextN<\@ne
      \PackageError{evenend}{The number of columns must be positive}{}%
      \global\evenend@nextN\@ne
    \fi
    \ifdim\pagegoal=\maxdimen
      \ifnum\evenend@colno=\z@
        \evenend@iffloatspending
          %% 本文はないが，いまの段組に置くフロートがある：ブロックとして確定する
          {\evenend@switchout}%
          %% このページにまだ段組がない：段数だけ変える
          {\evenend@switchnow}%
      \else
        \evenend@switchout
      \fi
    \else
      \evenend@switchout
    \fi
  \else
    \PackageError{evenend}{\string\evenendcolumns\space needs two-column
      mode}{Use the class option `twocolumn' or \string\twocolumn.}%
  \fi\fi}

%% いまの段組に置く（置かれるのを待つ）フロートがあるか
\def\evenend@iffloatspending{%
  \let\evenend@tmp\@secondoftwo
  \ifx\@toplist\@empty\else \let\evenend@tmp\@firstoftwo \fi
  \ifx\@botlist\@empty\else \let\evenend@tmp\@firstoftwo \fi
  \ifx\@midlist\@empty\else \let\evenend@tmp\@firstoftwo \fi
  \ifx\@deferlist\@empty\else \let\evenend@tmp\@firstoftwo \fi
  \ifdefined\@dblbotlist \ifx\@dblbotlist\@empty\else \let\evenend@tmp\@firstoftwo \fi\fi
  \evenend@tmp}

%% 空の箱と強制改段で最後の段を出力させる（空の箱はLua側で捨てる）
\def\evenend@switchout{%
  \global\evenend@switchtrue
  \global\evenend@finaltrue
  \nointerlineskip\vbox{}\penalty-\@M}

\def\evenend@switchnow{%
  \global\evenend@N\evenend@nextN
  \global\evenend@colsep\evenend@nextsep
  \global\evenend@colrule\evenend@nextrule
  \evenend@setwidth
  \global\col@number\evenend@N
  \evenend@fnreserve}

%% ---------------------------------------------------------------------
%% 段の取り込み：\@makecolの直前
\def\evenend@capture{%
  \if@twocolumn
    %% multicols環境の段組：\columnbreakの直前でわずかにはみ出す残りは，multicolと
    %% 同じくこの段に入れる（最後の段は除く）
    \ifevenend@inmc \ifnum\outputpenalty>-\@M
      \ifnum\numexpr\evenend@colno+\@ne<\evenend@N
        \ifnum\directlua{tex.sprint(evenend.mcoverflow(\number\baselineskip) and 1 or 0)}=\@ne
          \outputpenalty-\@M
        \fi
      \fi
    \fi \fi
    \evenend@spanprep
    \directlua{evenend.capture(\number\footins)}%
    \begingroup
      \def\@elt##1{\directlua{evenend.addfloat('top',\number##1,\evenend@spankof##1)}}%
      \@toplist
      \def\@elt##1{\directlua{evenend.addfloat('bot',\number##1,\evenend@spankof##1)}}%
      \@botlist
      %% この段のフロートの箱は出力の後に空くので，段をまたぐフロートの記録を消す
      \def\@elt##1{\evenend@spanclear##1}\@toplist\@botlist
    \endgroup
    \global\evenend@capturedtrue
    \ifvoid\footins\else \global\evenend@pagehasfntrue \evenend@fnreserve \fi
    \ifevenend@debug
      \typeout{evenend: column has footnotes=\ifvoid\footins no\else yes\fi,
        bottom floats=\ifx\@botlist\@empty no\else yes\fi}%
    \fi
    %% 揃える段では，\@makecolが組む段（使わずに捨てる）の警告を出さない
    \ifevenend@final \ifnum\outputpenalty>-\@M \else \vbadness\@M \fi \fi
  \fi}

%% 脚注：本文中に参照位置の印を置き，脚注の中身には同じ番号の属性を付ける
\AtBeginDocument{%
  \let\evenend@orig@makecol\@makecol
  %% 段の箱のはみ出しは，そのページを組み直さずに出力するときだけ警告する
  \def\@makecol{%
    \evenend@capture
    \if@twocolumn
      \edef\evenend@vfuzz{\number\vfuzz}%
      \vfuzz\maxdimen
      \evenend@fnabovespan\evenend@orig@makecol
      \directlua{evenend.checkcol(\number\@outputbox, \evenend@vfuzz)}%
      \vfuzz\evenend@vfuzz sp\relax
    \else
      \evenend@orig@makecol
    \fi}%
  \let\evenend@orig@footnotetext\@footnotetext
  \long\def\@footnotetext#1{%
    \begingroup
      \directlua{evenend.newfn()}%
      \ifhmode
        \vadjust{\directlua{evenend.anchor()}}%
      \else
        \ifvmode \directlua{evenend.anchor()}\fi
      \fi
      %% footnote=page：脚注を版面の全幅で組む
      \ifevenend@colmode\else \if@twocolumn \columnwidth\textwidth \fi\fi
      \evenend@orig@footnotetext{#1}%
    \endgroup}%
  %% クラスの脚注の設定を覚え，段を組むときの見込みを決める
  \global\evenend@topskip\topskip
  \global\evenend@maxdepth\maxdepth
  \global\evenend@fnskip\skip\footins
  \global\evenend@fncount\count\footins
  \begingroup \footnotesize \global\evenend@fnsmd\dp\strutbox \endgroup
  \global\evenend@docstartedtrue
  \evenend@fnreserve
  \directlua{evenend.debug = \ifevenend@debug true\else false\fi}%
}

%% ---------------------------------------------------------------------
%% 出力ルーチン
\def\@outputdblcol{%
  %% フロートだけの段（\@makecolを通らない）は，その中身をフロートとして取り込む
  \ifevenend@captured\else
    \directlua{evenend.capturefcol(\number\@outputbox)}%
    \global\evenend@capturedtrue
  \fi
  \evenend@status\z@
  \evenend@lastcolfalse
  \ifevenend@final
    %% 強制改段（\clearpageの\newpage）による出力だけを最終段とみなす
    \ifnum\outputpenalty>-\@M \else \evenend@lastcoltrue \fi
  \fi
  \ifevenend@lastcol
    \global\evenend@finalfalse
    \evenend@dobalancetrue
    %% \evenendcolumns*：揃えない（\evenend@switchfallbackがそのまま組む）
    \ifevenend@switch \ifevenend@nobalance \evenend@dobalancefalse \fi \fi
    \ifevenend@dobalance\ifevenend@pagebad
      \PackageWarningNoLine{evenend}{%
        Page \thepage\space contains a float column;\MessageBreak
        not balanced}%
    \else
      \ifevenend@switch
        \evenend@balance
      \else
        %% 最終ページ：持ち越された段内フロートも入れて揃えてみる．入り切らなければ，
        %% 入れずに揃える（持ち越されたフロートはLaTeXが後のページに出す）
        \global\evenend@takedeferredtrue
        \evenend@balance
        \global\evenend@takedeferredfalse
        \ifnum\evenend@status>\z@\else
          \evenend@iftakable{\evenend@balance}{}%
          \ifnum\evenend@status>\z@\else \evenend@warnfail \fi
        \fi
      \fi
    \fi\fi
  \fi
  \global\evenend@capturedfalse
  \let\evenend@next\evenend@normalcol
  \ifnum\evenend@status>\z@ \let\evenend@next\evenend@shipbalanced \fi
  %% footnote=page：ページの最後の段（揃えないとき，揃えられなかったとき）は，
  %% ページの本文を全幅の脚注の上に組み直して出力する
  \ifevenend@colmode\else
    \ifx\evenend@next\evenend@normalcol
      \ifevenend@lastcol
        \ifevenend@switch\else \let\evenend@next\evenend@fullship \fi
      \else
        \ifnum\numexpr\evenend@colno+\@ne\relax<\evenend@N\else
          \let\evenend@next\evenend@fullship
        \fi
      \fi
    \fi
  \fi
  \ifevenend@lastcol \ifevenend@switch
    \global\evenend@switchfalse
    \ifnum\evenend@status>\z@
      \let\evenend@next\evenend@pushblock
    \else
      \let\evenend@next\evenend@switchfallback
    \fi
  \fi \fi
  \evenend@next}

%% 揃えられなかったとき．このページの最後の段なら（ページが満杯で，段の下端は
%% もともとそろう）情報だけにする
\def\evenend@warnfail{%
  \ifnum\numexpr\evenend@colno+\@ne\relax<\evenend@N
    \PackageWarningNoLine{evenend}{Could not balance page \thepage}%
  \else
    \PackageInfo{evenend}{Page \thepage\space is full; not balanced}%
  \fi}

\def\evenend@shipbalanced{%
  \global\evenend@onlymarker\z@
  \ifnum\evenend@N=\@ne \ifvoid\evenend@pagetop
    \directlua{evenend.onlymarkercols()}%
  \fi\fi
  \ifnum\evenend@onlymarker=\@ne
    %% 段組の環境の後の目印だけのページ（文書末など）：出力しない
    \global\evenend@loosestatus\z@
    \global\evenend@colno\z@
    \global\@firstcolumntrue
    \directlua{evenend.reset()}%
  \else
    \expandafter\evenend@shipbalanced@
  \fi}
%% 1段の最後の段組は揃えない（揃えても意味がなく，\vfillなどが伸びなくなる）：
%% 中身のまま，積んだ段組があれば一緒に，版面の高さ（なければ\@colht）の箱に詰める
\def\evenend@shipbalanced@{%
  \ifnum\evenend@N=\@ne \ifnum\evenend@loosestatus>\z@
    \setbox\@outputbox\vbox{\unvbox\evenend@loosebox\@textbottom}%
    \global\evenend@loosestatus\z@
    \ifvoid\evenend@pagetop
      \setbox\@outputbox\vbox to\@colht{\unvbox\@outputbox}%
    \else
      \global\evenend@loosepagetrue
      \evenend@loosemerge{\@outputbox}%
    \fi
    \expandafter\evenend@shippage
  \else
    \expandafter\evenend@shipbalanced@@
  \fi \else
    \expandafter\evenend@shipbalanced@@
  \fi}
\def\evenend@shipbalanced@@{%
  \global\evenend@loosestatus\z@
  \evenend@makerow
  \evenend@takefn
  \evenend@shippage}
%% 中身のまま積んだ段組があるページで，最後の段組も1段なら，積んだものとその段の
%% 中身を版面の高さ（段組を積み始めたときの\@colht）の箱に詰める．\vfillなどが伸びる
\let\evenend@loosemerge@after\relax
\def\evenend@loosemerge#1{%
  \ifnum\evenend@N=\@ne \ifevenend@loosepage \ifvoid\evenend@pagetop\else
    %% （ページの脚注の領域は除く．shippageが版面の高さに包んで脚注を下端に置く）
    %% （積んだ段組が段の高さを超えていれば（組版の限界），詰めずにそのまま置く）
    \setbox#1\vbox{%
      \offinterlineskip
      \unvbox\evenend@pagetop
      \evenend@loosemerge@after
      \unvbox#1}%
    \ifdim\ht#1>\dimexpr\evenend@pagecolht-\evenend@pagefnspace\relax\else
      \setbox#1\vbox to\dimexpr\evenend@pagecolht-\evenend@pagefnspace\relax{\unvbox#1}%
    \fi
    \global\setbox\evenend@pagetop\box\voidb@x
    \global\evenend@loosepagefalse
    \global\evenend@loosemergedtrue
  \fi\fi\fi}

%% 揃えた段組をブロックとしてページの上部に積み，残りの高さで段組を続ける
\def\evenend@pushblock{%
  \evenend@makerow
  %% 脚注を先にページの脚注に移す（ブロックの下のアキは，その後の残りの高さで決める）
  \evenend@takefn
  \evenend@pushrow
  \evenend@switchnow
  \evenend@fnreserve
  %% 残りが少なければ，ここで改ページする．multicols環境を始めるときは，multicolと
  %% 同じく段組の前のアキを入れる前の残りが\premulticols未満なら改ページする
  \ifx\evenend@mcpremin\@empty
    \@tempdima\@colht
    \@tempdimb\dimexpr\evenend@blockmin\relax
  \else
    \@tempdima\dimexpr\@colht+\evenend@lastgap\relax
    \@tempdimb\evenend@mcpremin\relax
    \global\let\evenend@mcpremin\@empty
  \fi
  \ifdim\@tempdima<\@tempdimb
    \ifdim\@colht<\z@ \global\@colht\z@ \fi
    \setbox\@outputbox\vbox to\@colht{}%
    %% 次の段組は来ないので，積んだ段組の後のアキ（次の段組の頭の\topskipを見込んだ
    %% もの）は取り除く
    \let\evenend@loosemerge@after\unskip
    \evenend@loosemerge{\@outputbox}%
    \let\evenend@loosemerge@after\relax
    \evenend@shippage
  \fi}

%% 組んだ段組の行（\@outputbox）をページの上部に積み，\@colhtを減らす
%% ページの頭で，見える中身のない1段の段組（段組の環境の後の目印とグルーだけ）：
%% 積まず，段組の間のアキも入れない（ページの頭のアキはTeXが捨てるのと同じ）
\def\evenend@pushrow{%
  \let\evenend@next\evenend@pushrow@main
  \ifnum\evenend@loosestatus=\tw@
    \ifvoid\evenend@pagetop
      \let\evenend@next\evenend@pushrow@empty
    \else
      \global\evenend@loosestatus\@ne
    \fi
  \fi
  \evenend@next}
\def\evenend@pushrow@empty{%
  \global\evenend@loosestatus\z@
  \global\setbox\evenend@loosebox\box\voidb@x
  \global\evenend@colno\z@
  \global\@firstcolumntrue
  \global\evenend@pagebadfalse
  \global\setbox\@leftcolumn\box\voidb@x
  \global\evenend@mcbalfalse
  \directlua{evenend.reset()}}
\def\evenend@pushrow@main{%
  %% 1段の段組は，箱に詰めずに中身のまま積む（\vfillなどをページのグルーとして残す）
  \ifnum\evenend@loosestatus=\@ne
    \global\evenend@rowht\dimexpr\ht\evenend@loosebox+\dp\evenend@loosebox\relax
    \global\evenend@baseline\ht\evenend@loosebox
  \fi
  %% ブロックの間のアキ：前のブロックの最終行から次のブロックの1行目
  %% （\topskipの位置）までのベースライン間を\evenend@blockskipにする
  \ifx\evenend@blockgap\@empty
    \@tempdima\dimexpr\evenend@blockskip-\topskip
      -\evenend@rowht+\evenend@baseline\relax
    \ifdim\@tempdima<\z@ \@tempdima\z@ \fi
  \else
    %% blockgapは負でもよい（次の段組の先頭に目印を置くときは\topskipの分を差し引く）
    \@tempdima\dimexpr\evenend@blockgap\relax
  \fi
  %% 残りの高さが，このページの段組の始まり（表題や段抜きのフロートの下）から
  %% 行送りの位置で終わるように，アキを1行未満だけ広げる（行の位置がそろって
  %% いれば広げない）
  %% （ページの脚注の領域の分は\@colhtから除いてあるので，足して数える）
  \ifvoid\evenend@pagetop
    \global\evenend@pagecolht\dimexpr\@colht+\evenend@pagefnspace\relax
  \fi
  \@tempcnta\dimexpr\evenend@pagecolht-\@colht-\evenend@pagefnspace
    +\evenend@rowht+\@tempdima\relax
  \@tempcntb\baselineskip
  %% blockgapで指定したアキは広げない（multicolと同じ位置にする）
  \ifx\evenend@blockgap\@empty\else \@tempcntb\z@ \fi
  \ifnum\@tempcntb>\z@
    \count@\@tempcnta
    \divide\count@\@tempcntb
    \multiply\count@\@tempcntb
    \advance\@tempcnta-\count@   % 余り
    \ifnum\@tempcnta>\z@
      \advance\@tempdima\dimexpr\@tempcntb sp-\@tempcnta sp\relax
    \fi
  \fi
  %% ページの残りを超えるアキは入れない（その後はすぐ改ページになる）
  \@tempdimb\dimexpr\@colht-\evenend@rowht\relax
  \ifdim\@tempdima>\@tempdimb
    \@tempdima\@tempdimb
    \ifdim\@tempdima<\z@ \@tempdima\z@ \fi
  \fi
  \global\setbox\evenend@pagetop\vbox{%
    \offinterlineskip
    \ifvoid\evenend@pagetop\else \unvbox\evenend@pagetop \fi
    \ifnum\evenend@loosestatus=\@ne
      \unvbox\evenend@loosebox
    \else
      \box\@outputbox
    \fi
    \vskip\@tempdima}%
  \ifnum\evenend@loosestatus=\@ne \global\evenend@loosepagetrue \fi
  \global\evenend@loosestatus\z@
  \global\advance\@colht-\dimexpr\evenend@rowht+\@tempdima\relax
  \global\evenend@lastgap\@tempdima
  %% ブロックを積んだページには，もう段抜きフロートを置かない（上端に置けば前の
  %% ブロックより上に，下端に置けば後のブロックより下に来るので）．持ち越して，
  %% 次の切り換えでそのブロックの下に置く
  \global\@dbltopnum\m@ne
  \ifdefined\@dblbotnum \global\@dblbotnum\m@ne \fi
  \global\evenend@colno\z@
  \global\@firstcolumntrue
  \global\evenend@pagebadfalse
  \global\setbox\@leftcolumn\box\voidb@x
  \global\let\evenend@resv\@empty
  \global\let\evenend@resvfn\@empty
  \global\evenend@rowdp\z@
  \evenend@fnrestore
  \global\evenend@mcbalfalse
  \directlua{evenend.reset()}}

%% 揃えられなかったとき：持ち越したフロートを除いて本文だけで揃えられれば，
%% そうしてこのページを終える．それもできなければ，いまの段組のままページを
%% 終える．持ち越したフロートは，次のページの上に元の段数のブロックとして
%% 置いてから段数を変える
\def\evenend@switchfallback{%
  \let\evenend@held\@deferlist
  \global\let\@deferlist\@empty
  \ifevenend@nobalance \let\evenend@held@test\@empty \else \let\evenend@held@test\evenend@held \fi
  \ifx\evenend@held@test\@empty
    \evenend@status\z@
  \else
    \global\evenend@switchtrue
    \evenend@balance
    \global\evenend@switchfalse
  \fi
  \ifnum\evenend@status>\z@
    \evenend@makerow
    \evenend@takefn
    \evenend@pushrow
    \ifdim\@colht<\z@ \global\@colht\z@ \fi
    \setbox\@outputbox\vbox to\@colht{}%
    \evenend@shippage
  \else
    \ifevenend@nobalance\else \evenend@warnfail \fi
    \ifevenend@colmode
      \evenend@normalcol
      \@whilenum\evenend@colno>\z@\do{%
        \setbox\@outputbox\vbox to\@colht{}%
        \evenend@normalcol}%
    \else
      \evenend@fullship
    \fi
  \fi
  \global\let\@deferlist\evenend@held
  \global\evenend@nobalancefalse
  \ifx\@deferlist\@empty
    \evenend@switchnow
    \evenend@fnreserve
  \else
    \evenend@floatblock
  \fi}

%% 持ち越されたフロートだけのブロックを組む
\let\evenend@flrest\@empty
%% \@deferlistの最後の要素を\evenend@flrestの先頭へ移す（2つ以上あるときだけ．
%% 移したら\evenend@tmpを\@firstoftwoにする）
\def\evenend@poplast{%
  \let\evenend@tmp\@secondoftwo
  \global\let\evenend@a\@empty \global\let\evenend@b\@empty
  \def\@elt##1{\xdef\evenend@a{\unexpanded\expandafter{\evenend@a}\unexpanded\expandafter{\evenend@b}}\gdef\evenend@b{\@elt##1}}%
  \@deferlist
  \let\@elt\relax
  \ifx\evenend@a\@empty\else
    \global\let\@deferlist\evenend@a
    \xdef\evenend@flrest{\unexpanded\expandafter{\evenend@b}\unexpanded\expandafter{\evenend@flrest}}%
    \let\evenend@tmp\@firstoftwo
  \fi
  \evenend@tmp}
\def\evenend@floatblock{%
  \directlua{evenend.reset() evenend.emptycolumn()}%
  \global\evenend@switchtrue
  \evenend@balance
  \global\evenend@switchfalse
  \ifnum\evenend@status>\z@
    \ifx\evenend@flrest\@empty
      \evenend@pushblock
      \let\evenend@next\relax
    \else
      %% 一部だけ組めた：このページに積んでページを終え，残りで次のページにもう一度
      \evenend@makerow
      \evenend@pushrow
      \ifdim\@colht<\z@ \global\@colht\z@ \fi
      \setbox\@outputbox\vbox to\@colht{}%
      \xdef\evenend@flrest{\unexpanded\expandafter{\@deferlist}\unexpanded\expandafter{\evenend@flrest}}%
      \global\let\@deferlist\@empty
      \evenend@shippage
      \global\let\@deferlist\evenend@flrest
      \global\let\evenend@flrest\@empty
      \let\evenend@next\evenend@floatblock
    \fi
  \else
   \evenend@poplast{\let\evenend@next\evenend@floatblock}{%
   \xdef\@deferlist{\unexpanded\expandafter{\@deferlist}\unexpanded\expandafter{\evenend@flrest}}%
   \global\let\evenend@flrest\@empty
    %% フロートだけのブロックも組めない（段より高いフロートなど）：LaTeXの
    %% フロート段として元の段数のまま出し，ページを終える．残ったフロート
    %% （[p]のないものなど）は，次のページでもう一度ブロックに組んでみる
    \directlua{evenend.reset()}%
    \let\evenend@before\@deferlist
    \@makefcolumn\@deferlist
    \@whilesw\if@fcolmade\fi{\@opcol\@makefcolumn\@deferlist}%
    \@whilenum\evenend@colno>\z@\do{%
      \setbox\@outputbox\vbox to\@colht{}%
      \evenend@normalcol}%
    \let\evenend@next\evenend@floatblock
    \ifx\@deferlist\@empty \let\evenend@next\evenend@switchnow \fi
    \ifx\@deferlist\evenend@before \let\evenend@next\evenend@switchnow \fi}%
  \fi
  \evenend@next}

%% 段間の罫：#1は罫の高さ，#2は段の箱の高さ．段をまたぐフロートのある所は
%% 避ける（\evenend@rtopから\evenend@rendまで．\evenend@rendが0なら#1まで）
%% \evenend@rtwotopが0でなければ，\evenend@rtwotopから\evenend@rtwoendまでにも引く
%% （spanfootnote=bottomで，段をまたぐ図の下の脚注の横）
\newdimen\evenend@rtop
\newdimen\evenend@rend
\newdimen\evenend@rtwotop
\newdimen\evenend@rtwoend
\def\evenend@sep#1#2{%
  \hfil
  \vbox to#2{%
    \offinterlineskip  % 2本めの罫の前に行間のアキを入れない
    \kern\evenend@rtop
    \hbox{\normalcolor\vrule \@width\evenend@colrule
      \@height\dimexpr\ifdim\evenend@rend>\z@\evenend@rend\else#1\fi-\evenend@rtop\relax
      \@depth\z@}%
    \ifdim\evenend@rtwotop>\z@
      \kern\dimexpr\evenend@rtwotop-\ifdim\evenend@rend>\z@\evenend@rend\else#1\fi\relax
      \hbox{\normalcolor\vrule \@width\evenend@colrule
        \@height\dimexpr\evenend@rtwoend-\evenend@rtwotop\relax \@depth\z@}%
    \fi
    \vss}%
  \hfil}

\newcount\evenend@onlymarker
\def\evenend@normalcol{%
  \global\evenend@onlymarker\z@
  \ifnum\evenend@N=\@ne \ifvoid\evenend@pagetop
    \directlua{evenend.onlymarker(\number\@outputbox)}%
  \fi\fi
  \ifnum\evenend@onlymarker=\@ne
    %% 段組の環境の後の目印だけのページ（目印の直後に改ページした）：出力しない
    \global\setbox\@outputbox\box\voidb@x
    \global\evenend@colno\z@
    \global\@firstcolumntrue
    \directlua{evenend.reset()}%
  \else
    \expandafter\evenend@normalcol@
  \fi}
\def\evenend@normalcol@{%
  \evenend@loosemerge{\@outputbox}%
  \global\advance\evenend@colno\@ne
  %% 段をまたぐフロートの場所取りがこの段にあれば，罫はその所を避け，段間の両側の
  %% 本文（と脚注）の行の字のある範囲に引く．組み上げた段の箱をLua側でたどって測る
  \directlua{evenend.colrule(\number\@outputbox, \number\evenend@colno,
    \number\evenend@nt, \number\evenend@nb,
    \ifdim\evenend@phtop>\z@ true\else false\fi,
    \ifdim\evenend@phbot>\z@ true\else false\fi)}%
  \ifevenend@floatgrid \ifnum\evenend@gridreport>\z@
    \directlua{evenend.gridcheck(\number\@outputbox, \number\evenend@nt, \number\evenend@nb,
      \ifdim\topskip=\z@ \number\evenend@topskip \else \number\topskip \fi,
      \number\baselineskip)}%
  \fi\fi
  \global\setbox\@leftcolumn\hbox{%
    \unhbox\@leftcolumn
    \ifnum\evenend@colno>\@ne
      \evenend@sep\@colht\@colht
    \fi
    \hb@xt@\columnwidth{\box\@outputbox \hss}}%
  \ifnum\evenend@colno<\evenend@N
    \global\@firstcolumnfalse
  \else
    \setbox\@outputbox\vbox{\hb@xt@\textwidth{\unhbox\@leftcolumn}}%
    \directlua{evenend.reportoverfull()}%
    \directlua{tex.setcount('global', 'evenend@gridflag', evenend.gridbad and 1 or 0)}%
    \ifnum\evenend@gridflag>\z@ \evenend@gridbadpage \fi
    \evenend@shippage
  \fi}

\def\evenend@shippage{%
  \global\evenend@loosepagefalse
  %% footnote=page：ページの最後の段組を段の高さまで延ばし（下に置く段抜きフロートが
  %% 版面の下端に来るように），ページの脚注があれば，その下端に全幅で置く
  \ifevenend@colmode\else
    \evenend@mkfnrule
    %% 段抜きフロートを重ねるとき（\@combinedblfloats）に箱が開かれても高さが保たれる
    %% ように，高さを決めた箱をもう一段包む
    %% （積んだブロックと一緒に詰めた段組（\evenend@loosemerge）は版面の高さに包む）
    \ifevenend@loosemerged
      \@tempdima\evenend@pagecolht
    \else
      \@tempdima\dimexpr\@colht+\evenend@pagefnspace\relax
    \fi
    \setbox\@outputbox\vbox{\vbox to\@tempdima{%
      %% 揃えた段組は最終行のベースラインから数える（行の深さは脚注の上のアキに出る）
      %% （中身のまま詰めた1段の段組は，箱の深さが最終行の深さ）
      \@tempdimb\dp\@outputbox
      \box\@outputbox
      \kern-\dimexpr\evenend@rowdp+\@tempdimb\relax
      \vfill
      \ifvoid\evenend@pagefn\else
        \vskip\evenend@fnskip
        \color@begingroup\normalcolor
        \unvbox\evenend@fnrulebox
        \unvbox\evenend@pagefn
        \color@endgroup
      \fi}}%
  \fi
  \global\setbox\evenend@pagefn\box\voidb@x
  \global\evenend@pagefnspace\z@
  \global\evenend@rowdp\z@
  \global\evenend@loosemergedfalse
  \global\evenend@pagehasfnfalse
  \global\let\evenend@resv\@empty
  \global\let\evenend@resvfn\@empty
  \evenend@fnrestore
  \global\evenend@colno\z@
  \global\@firstcolumntrue
  \global\evenend@pagebadfalse
  \global\setbox\@leftcolumn\box\voidb@x
  \directlua{evenend.reset()}%
  %% このページで確定したブロックを上に積む
  \ifvoid\evenend@pagetop\else
    \setbox\@outputbox\vbox{%
      \offinterlineskip
      \unvbox\evenend@pagetop
      \box\@outputbox}%
    \global\setbox\evenend@pagetop\box\voidb@x
  \fi
  \@combinedblfloats
  \@outputpage
  \begingroup
    \@dblfloatplacement
    \@startdblcolumn
    \@whilesw\if@fcolmade \fi{\@outputpage\@startdblcolumn}%
  \endgroup
  \evenend@fnreserve}

%% ---------------------------------------------------------------------
%% footnote=page：脚注を版面の全幅で版面の下端に置く（multicolと同じ）
%% LaTeXが段を組むあいだ，脚注は全段の高さを減らすので，その高さを段数倍で見込む
%% （\count\footins）．脚注の上のアキ（\skip\footins）は，ページの最初の脚注の
%% ときだけ段数倍で見込む．ページの最後の段で，ページの本文を，版面からページの脚注を
%% 除いた高さの段に組み直す（入り切らない本文はその脚注とともに次のページへ送り返す）
\newif\ifevenend@docstarted
\def\evenend@fnreserve{%
  \ifevenend@docstarted
    \ifevenend@colmode
      %% footnote=column：脚注の設定は変えない．文書の途中でクラスなどが変えることが
      %% あるので，そのときの値を覚え直す（段をまたぐ下の図のために一時的に0にして
      %% いるあいだは除く）
      \ifevenend@fnadj\else
        \global\evenend@fncount\count\footins
        \global\evenend@fnskip\skip\footins
      \fi
    \else\if@twocolumn
      \global\count\footins\numexpr\evenend@N*\evenend@fncount\relax
      \ifevenend@pagehasfn
        \global\skip\footins\z@
      \else
        \global\skip\footins\evenend@fnskip
        \global\multiply\skip\footins\evenend@N
      \fi
    \else
      \global\count\footins\evenend@fncount
      \global\skip\footins\evenend@fnskip
    \fi\fi
  \fi}
%% ページの最後の段は，段数×行送りだけ多めに詰めさせる（LaTeXが段ごとに改段すると
%% 段ごとに1行未満の余りが出て，組み直した段の本文が足りなくなるので．入り切らない
%% 分は次のページへ送り返す）
\def\evenend@extraroom{%
  \ifevenend@colmode\else \if@twocolumn \ifnum\evenend@N>\@ne
    \ifnum\numexpr\evenend@colno+\@ne\relax=\evenend@N
      \global\advance\@colroom\evenend@N\baselineskip
    \fi
  \fi\fi\fi}
%% 全幅の脚注罫
\def\evenend@mkfnrule{%
  \setbox\evenend@fnrulebox\vbox{%
    \ifevenend@colmode\else \columnwidth\textwidth \fi
    \footnoterule}}
%% Lua側が組んだ脚注をページの脚注に加え，その分だけ段の高さ（\@colht）を減らす
\def\evenend@takefn{%
  \directlua{evenend.getfn(\number\evenend@scratch)}%
  \ifvoid\evenend@scratch\else
    \global\setbox\evenend@pagefn\vbox{%
      \ifvoid\evenend@pagefn\else \unvbox\evenend@pagefn \fi
      \unvbox\evenend@scratch}%
    \evenend@mkfnrule
    \dimen@\dimexpr\evenend@fnskip+\ht\evenend@fnrulebox+\dp\evenend@fnrulebox
      +\ht\evenend@pagefn\relax
    \global\advance\@colht-\dimexpr\dimen@-\evenend@pagefnspace\relax
    \global\evenend@pagefnspace\dimen@
    \global\evenend@pagehasfntrue
  \fi}
%% ページの本文を組み直して出力する．入り切らない本文は次のページへ送り返す
\def\evenend@fullship{%
  \global\evenend@fixedtrue
  \evenend@balance
  \global\evenend@fixedfalse
  \ifnum\evenend@status>\z@
    \evenend@makerow
    \evenend@takefn
    \directlua{evenend.getpush(\number\evenend@pushbox)}%
    \evenend@shippage
    \ifvoid\evenend@pushbox\else
      %% 揃えるページの本文が入り切らなかったときは，次のページで揃える
      \ifevenend@lastcol \global\evenend@finaltrue \fi
      \directlua{evenend.fixcontrib()}%
      \unvbox\evenend@pushbox
    \fi
  \else
    \PackageWarningNoLine{evenend}{Could not rebuild page \thepage\space
      with full-width footnotes}%
    \evenend@normalcol
    \@whilenum\evenend@colno>\z@\do{%
      \setbox\@outputbox\vbox to\@colht{}%
      \evenend@normalcol}%
  \fi}

%% まだ出ていない（持ち越された）フロートをLua側に渡す（段抜きは深さ1sp）．
%% 段数を切り換えるとき：そのブロックのフロートはそのブロックの中に置く．
%% 文書末などの最終ページ：段内フロートだけを渡す（入り切らなければ渡さずに揃え，
%% 持ち越されたフロートはLaTeXが同じ段数で後のページに出す）．
%% 段内フロートは段の上に置くので，渡す前にフックevenend/deferredfloatを
%% 呼ぶ（\evenendfloatboxがその箱．フロートの中身の位置を整えるパッケージ用）
\NewHook{evenend/deferredfloat}
\newif\ifevenend@takedeferred
%% 持ち越された段内フロート（段抜きでないもの）があるか
\def\evenend@iftakable{%
  \let\evenend@tmp\@secondoftwo
  \def\@elt##1{\ifdim\dp##1=1sp\else\let\evenend@tmp\@firstoftwo\fi}%
  \@deferlist
  \let\@elt\relax
  \evenend@tmp}
\def\evenend@collectdeferred{%
  \global\evenend@dblbotadj\z@
  \ifevenend@takedeferred
    \begingroup
      \def\@elt##1{%
        \ifdim\dp##1=1sp\else
          \evenend@ifpasscol##1{%
            \let\evenendfloatbox##1%
            \UseHook{evenend/deferredfloat}%
            \directlua{evenend.adddeferred('col', \number##1, \evenend@spankof##1, \number\count##1)}}{}%
        \fi}%
      \@deferlist
    \endgroup
  \fi
  \ifevenend@switch
    %% stfloatsが版面の下端に予約した段抜きフロートも，このブロックの下に置く
    \ifdefined\@dblbotlist
      \begingroup
        \def\@elt##1{%
          \global\advance\evenend@dblbotadj\dimexpr\ht##1+\dp##1+%
            \ifdim\evenend@dblbotadj=\z@ \dbltextfloatsep\else\dblfloatsep\fi\relax
          \directlua{evenend.adddeferred('dbl', \number##1)}}%
        \@dblbotlist
      \endgroup
    \fi
    \begingroup
      \def\@elt##1{%
        \ifdim\dp##1=1sp
          \directlua{evenend.adddeferred('dbl', \number##1)}%
        \else
          \evenend@ifpasscol##1{%
            \let\evenendfloatbox##1%
            \UseHook{evenend/deferredfloat}%
            \directlua{evenend.adddeferred('col', \number##1, \evenend@spankof##1, \number\count##1)}}{}%
        \fi}%
      \@deferlist
    \endgroup
  \fi}

\def\evenend@balance{%
  \evenend@collectdeferred
  \begingroup
    \setbox\evenend@topfigbox\vbox{\topfigrule}%
    \setbox\evenend@botfigbox\vbox{\botfigrule}%
    \evenend@mkfnrule
    \setbox\evenend@textbottombox\vbox{\@textbottom}%
    %% 出力ルーチンは箱の中の段組（\topskipを0にする）の途中で呼ばれることがあるので，
    %% そのときは最後に見た0でない\topskipと\maxdepthを使う（文書の途中で文字の大きさを
    %% 変えて\topskipを変えることがあるので，ふだんはそのときの値を使い，覚え直す）
    \ifdim\topskip=\z@
      \topskip\evenend@topskip
      \maxdepth\evenend@maxdepth
    \else
      \global\evenend@topskip\topskip
      \global\evenend@maxdepth\maxdepth
    \fi
    \splittopskip\topskip
    \splitmaxdepth\maxdepth
    \vbadness\@M
    \vfuzz\maxdimen
    \directlua{evenend.balance{
      N       = \the\evenend@N,
      colht   = \number\dimexpr\@colht+\evenend@dblbotadj\relax,
      colmode = \ifevenend@colmode true\else false\fi,
      block   = \ifevenend@switch true\else false\fi,
      floatgrid = \ifevenend@floatgrid true\else false\fi,
      %% フックevenend/deferredfloatに処理があれば（gyoudoriなど），持ち越されたフロートは
      %% 上に置く前提で組み直されるので，上だけに置く
      deferbot = \IfHookEmptyTF{evenend/deferredfloat}{true}{false},
      spanfnbottom = \ifevenend@sfb true\else false\fi,
      fullfn  = \ifevenend@colmode false\else true\fi,
      fixed   = \ifevenend@fixed true\else false\fi,
      pageempty = \ifvoid\evenend@pagetop\ifx\@dbltoplist\@empty true\else false\fi\else false\fi,
      fnskip  = \number\evenend@fnskip,
      fnold   = \number\evenend@pagefnspace,
      fnoldd  = \number\dp\evenend@pagefn,
      fnsmd   = \number\evenend@fnsmd,
      fnsep   = \number\footnotesep,
      fnfloatpen = \number\@MM,
      textbottom = \number\evenend@textbottombox,
      headblock = \ifevenend@headblock\ifvoid\evenend@pagetop false\else true\fi\else false\fi,
      footins = \number\footins,
      blskip  = \number\baselineskip,
      scratch = \number\evenend@scratch,
      topfig  = \number\evenend@topfigbox,
      botfig  = \number\evenend@botfigbox,
      fnrule  = \number\evenend@fnrulebox,
      mcbal   = \ifevenend@mcbal true\else false\fi,
      mcragged = \ifnum\evenend@mcshrink=\@ne true\else false\fi,
      loose   = \number\evenend@loosebox,
      havetop = \ifvoid\evenend@pagetop false\else true\fi,
    }}%
    \ifnum\evenend@status>\z@
      \PackageInfo{evenend}{Page \thepage: columns balanced at
        \the\evenend@height\ifevenend@switch\space (block)\fi}%
      %% 持ち越されたフロートは揃えた段組に入れたので，リストから外す
      \ifevenend@takedeferred
        %% 入れた段内フロートを持ち越しのリストから外す（段抜きのものは残す）
        \global\let\evenend@a\@empty \global\let\evenend@b\@empty
        \def\@elt##1{\ifdim\dp##1=1sp \g@addto@macro\evenend@b{\@elt##1}\else
          \evenend@ifpasscol##1{\evenend@spanclear##1\g@addto@macro\evenend@a{\@elt##1}}%
            {\g@addto@macro\evenend@b{\@elt##1}}\fi}%
        \@deferlist
        \let\@elt\relax
        \xdef\@freelist{\@freelist\evenend@a}%
        \global\let\@deferlist\evenend@b
      \fi
      \ifevenend@switch
        %% 入れたフロートを持ち越しのリストから外す（段組より広い段をまたぐフロートは残す）
        \global\let\evenend@a\@empty \global\let\evenend@b\@empty
        \def\@elt##1{\ifdim\dp##1=1sp \g@addto@macro\evenend@a{\@elt##1}\else
          \evenend@ifpasscol##1{\evenend@spanclear##1\g@addto@macro\evenend@a{\@elt##1}}%
            {\g@addto@macro\evenend@b{\@elt##1}}\fi}%
        \@deferlist
        \let\@elt\relax
        \xdef\@freelist{\@freelist\evenend@a}%
        \global\let\@deferlist\evenend@b
        \ifdefined\@dblbotlist
          \xdef\@freelist{\@freelist\@dblbotlist}%
          \global\let\@dblbotlist\@empty
          \global\advance\@colht\evenend@dblbotadj
        \fi
      \fi
    \fi
  \endgroup}

\def\evenend@makerow{%
  \global\setbox\@leftcolumn\box\voidb@x
  \@tempcnta\z@
  \setbox\@tempboxa\hbox{}%
  \@whilenum\@tempcnta<\evenend@N\do{%
    \advance\@tempcnta\@ne
    \directlua{evenend.getcolumn(\the\@tempcnta, \number\evenend@colbox)}%
    \setbox\@tempboxa\hbox{%
      \unhbox\@tempboxa
      \ifnum\@tempcnta>\@ne \evenend@sep\evenend@ruleht\evenend@colboxht \fi
      \hb@xt@\columnwidth{\box\evenend@colbox \hss}}}%
  \directlua{evenend.getdbl(\number\evenend@colbox)}%
  \setbox\@outputbox\vbox{%
    \offinterlineskip
    \ifdim\evenend@headshift=\z@\else \kern\evenend@headshift \fi
    \hb@xt@\textwidth{\unhbox\@tempboxa}%
    \ifvoid\evenend@colbox\else \box\evenend@colbox \fi}%
  \global\evenend@rowdp\dimexpr\ht\@outputbox-\evenend@baseline\relax
  \ifdim\evenend@rowdp<\z@ \global\evenend@rowdp\z@ \fi}

%% ---------------------------------------------------------------------
%% 段をまたぐフロート：\begin{spanfigure}[位置]{段数}，spantable
%% 置かれた段を左端にして，右へ段数ぶんの幅で組む．置かれた段では中身を右の段まで
%% はみ出させ，右の段には同じ高さの空の箱（場所取り）を，上なら段の最初，下なら段の
%% 最後のフロートとして置く．右端を越える段と，フロートだけの段には置かない．
%% 位置はtとbだけ（hとpは使わない）で，!を付けて上・下の領域の割合の制限を外す
\newcount\evenend@spank
\newdimen\evenend@phtop    % 出力する段の上の場所取りの高さ
\newdimen\evenend@phbot    % 出力する段の下の場所取りの高さ
\newif\ifevenend@spanbot   % 出力する段の下に段をまたぐフロートか場所取りがある
\newcount\evenend@nt       % 出力する段の上のフロートの数（場所取りを含む）
\newcount\evenend@nb       % 同じく下のフロートの数
\newdimen\evenend@spanwd
\newif\ifevenend@infcol    % \@tryfcolumnの中（フロートだけの段を作ろうとしている）
\def\evenend@resv{}        % このページで場所取りを置く段：\evenend@rv{段}{t|b}{高さ}
\NewDocumentEnvironment{spanfigure}{O{\fps@figure} m}
  {\evenend@spanbegin{figure}{#1}{#2}}{\evenend@spanend}
\NewDocumentEnvironment{spantable}{O{\fps@table} m}
  {\evenend@spanbegin{table}{#1}{#2}}{\evenend@spanend}
\def\evenend@spanbegin#1#2#3{%
  \global\evenend@spank=\numexpr#3\relax
  \ifnum\evenend@spank<\@ne \global\evenend@spank\@ne \fi
  \ifnum\evenend@spank>\evenend@N
    \PackageWarning{evenend}{A span float wider than the number of columns;\MessageBreak
      using \the\evenend@N\space columns}%
    \global\evenend@spank\evenend@N
  \fi
  %% 位置：tとbだけを残し，!を付ける
  \let\evenend@tmp\@empty
  \edef\evenend@fps{#2}%
  \expandafter\@tfor\expandafter\reserved@a\expandafter:\expandafter=\evenend@fps\do{%
    \if\reserved@a t\edef\evenend@tmp{\evenend@tmp t}\fi
    \if\reserved@a b\edef\evenend@tmp{\evenend@tmp b}\fi}%
  \ifx\evenend@tmp\@empty \def\evenend@tmp{tb}\fi
  \global\evenend@spanwd=\numexpr\evenend@spank\relax\columnwidth
  \global\advance\evenend@spanwd\numexpr\evenend@spank-\@ne\relax\evenend@colsep
  %% フロートの箱の中身は，またがる段の全幅で組む
  \let\evenend@orig@endfloatbox\@endfloatbox
  \def\@endfloatbox{\evenend@orig@endfloatbox \evenend@spanfix}%
  %% クラスのfigure（table）環境の始まりの処理を活かすため，その環境を呼び，
  %% 中の\@floatだけを差し替える
  \edef\evenend@spanfloat{\noexpand\@xfloat{#1}[!\evenend@tmp]}%
  \def\@float##1{\evenend@spanfloat \hsize\evenend@spanwd \linewidth\hsize}%
  \def\evenend@spanend{\csname end#1\endcsname}%
  \csname #1\endcsname}
%% 組み上げた箱：幅は段幅にし（中身は右へはみ出す），段数を記録する
\def\evenend@spanfix{%
  \ifnum\@floatpenalty<\z@
    %% 上か下に置ける高さに抑える（置けないと最後まで置けないので）
    \@tempdima\dimexpr\textheight-\textfloatsep\relax
    \ifdim\ht\@currbox>\@tempdima
      \PackageWarning{evenend}{Span float too large for page}%
      \global\ht\@currbox\@tempdima
    \fi
    \global\wd\@currbox\columnwidth
    \directlua{evenend.markspan(\number\@currbox, \the\evenend@spank)}%
    \expandafter\xdef\csname evenend@span@\number\@currbox\endcsname
      {\number\evenend@spanwd}%
  \fi}
%% 段をまたぐフロート#1が，いまの段組（段幅と段間）でまたがる段数．記録は箱の中身の
%% 幅なので，段数を切り換えた後の段組に持ち越されても正しく数える
\def\evenend@spankeff#1{\directlua{evenend.spank(\csname evenend@span@\number#1\endcsname,
  \number\columnwidth, \number\evenend@colsep)}}
%% 持ち越されたフロート#1を，揃えるいまの段組に入れられるか（段をまたぐフロートは，
%% 段組の幅を越えないときだけ）
\def\evenend@ifpasscol#1{%
  \ifcsname evenend@span@\number#1\endcsname
    \ifnum\evenend@spankeff#1>\evenend@N
      \expandafter\expandafter\expandafter\@secondoftwo
    \else
      \expandafter\expandafter\expandafter\@firstoftwo
    \fi
  \else
    \expandafter\@firstoftwo
  \fi}
\def\evenend@ifspan#1{%
  \ifcsname evenend@span@\number#1\endcsname
    \expandafter\@firstoftwo
  \else\ifcsname evenend@ph@\number#1\endcsname
    \expandafter\expandafter\expandafter\@firstoftwo
  \else
    \expandafter\expandafter\expandafter\@secondoftwo
  \fi\fi}
%% フロートを置けるか（LaTeXの段幅の検査に足す）：段をまたぐフロートは，
%% 置く段から右へ段数ぶんが右端を越えず，フロートだけの段でないときだけ置く．
%% またがる段に，同じ位置（上か下）の場所取りやほかの段をまたぐフロートがあれば，
%% その位置には置かない（位置の指定からその位置を一時的に外し，置き終えたら戻す）
\def\evenend@spantest#1{%
  \ifevenend@infcol
    \global\@testtrue
  \else
    \ifnum\numexpr\evenend@colno+\evenend@spankeff#1\relax
          >\evenend@N
      \global\@testtrue
    \else
      \evenend@spanconflicts#1%
      \@tempcnta\count#1\relax
      \@tempcntb\@tempcnta \divide\@tempcntb\tw@
      \ifodd\@tempcntb \ifevenend@conft \advance\@tempcnta-\tw@ \fi \fi
      \@tempcntb\count#1\relax \divide\@tempcntb4\relax
      \ifodd\@tempcntb \ifevenend@confb \advance\@tempcnta-4\relax \fi \fi
      %% 上にも下にも置けない
      \@tempcntb\@tempcnta \divide\@tempcntb\tw@
      \ifodd\@tempcntb\else
        \@tempcntb\@tempcnta \divide\@tempcntb4\relax
        \ifodd\@tempcntb\else \global\@testtrue \fi
      \fi
      \ifnum\@tempcnta=\count#1\else
        \xdef\evenend@spanrestore{\global\count\number#1=\the\count#1\relax}%
        \global\count#1\@tempcnta
      \fi
    \fi
  \fi}
\newif\ifevenend@conft
\newif\ifevenend@confb
\let\evenend@spanrestore\relax
%% 置こうとしている段から右へ段数ぶんの段で，上・下それぞれに衝突があるか
\def\evenend@spanconflicts#1{%
  \global\evenend@conftfalse \global\evenend@confbfalse
  \edef\evenend@c{\the\numexpr\evenend@colno+\@ne}%
  \edef\evenend@e{\the\numexpr\evenend@colno+\evenend@spankeff#1}%
  \def\evenend@rv##1##2##3{%
    \ifnum##1<\evenend@c\relax\else\ifnum##1>\evenend@e\relax\else
      \if##2t\global\evenend@confttrue\else\global\evenend@confbtrue\fi
    \fi\fi}%
  \evenend@resv
  \def\@elt##1{\evenend@ifspan##1{\global\evenend@confttrue}{}}\@toplist
  \def\@elt##1{\evenend@ifspan##1{\global\evenend@confbtrue}{}}\@botlist
  \let\@elt\relax}
\AtBeginDocument{%
  \let\evenend@orig@testwrongwidth\@testwrongwidth
  \def\@testwrongwidth#1{%
    \evenend@orig@testwrongwidth#1%
    \ifcsname evenend@span@\number#1\endcsname \evenend@spantest#1\fi}%
  \let\evenend@orig@tryfcolumn\@tryfcolumn
  \def\@tryfcolumn#1{%
    \global\evenend@infcoltrue
    \evenend@orig@tryfcolumn#1%
    \global\evenend@infcolfalse}%
  \let\evenend@orig@startcolumn\@startcolumn
  \def\@startcolumn{\evenend@startcolumn\evenend@extraroom}%
  %% 位置の指定を一時的に外したときは，置き終えたら戻す
  \let\evenend@orig@addtocurcol\@addtocurcol
  \def\@addtocurcol{\evenend@orig@addtocurcol
    \evenend@spanrestore\global\let\evenend@spanrestore\relax}%
  \let\evenend@orig@addtonextcol\@addtonextcol
  \def\@addtonextcol{\evenend@orig@addtonextcol
    \evenend@spanrestore\global\let\evenend@spanrestore\relax}
  \let\evenend@orig@doclearpage\@doclearpage
  \def\@doclearpage{\evenend@spantodbl\evenend@orig@doclearpage}}
%% \clearpageでは，LaTeXは残ったフロートをフロートだけのページにしか出さない．
%% 段をまたぐフロートはフロートだけの段に置かないので，段抜きのフロートとして出す
%% （フロートだけのページの左上に，またがる幅で置かれる）
\def\evenend@spantodbl{%
  \def\@elt##1{%
    \ifcsname evenend@span@\number##1\endcsname
      \evenend@spanclear##1%
      \global\dp##1=1sp
      \PackageInfo{evenend}{A span float is output on a float page}%
    \fi}%
  \@deferlist
  \let\@elt\relax}
%% 段の始まり：この段に場所取りがあれば，フロートだけの段は作らず，場所取りを
%% 上（下）のフロートとして先に置いてから，持ち越されたフロートを試す
\def\evenend@startcolumn{%
  \edef\evenend@c{\the\numexpr\evenend@colno+\@ne}%
  \let\evenend@hasresv\@empty
  \def\evenend@rv##1##2##3{\ifnum##1=\evenend@c\relax \def\evenend@hasresv{x}\fi}%
  \evenend@resv
  \ifx\evenend@hasresv\@empty
    \evenend@orig@startcolumn
  \else
    \global\@colroom\@colht
    \global\@fcolmadefalse
    \def\evenend@rv##1##2##3{\ifnum##1=\evenend@c\relax \evenend@placeholder{##2}{##3}\fi}%
    \evenend@resv
    %% spanfootnote=bottom：この段の脚注は，場所取りの中の下（左の段の脚注の高さまで）に
    %% 収める．脚注で本文の量を減らさないように，\count\footinsと\skip\footinsを0にする
    \def\evenend@rf##1##2{\ifnum##1=\evenend@c\relax \evenend@fnadjust{##2}\fi}%
    \evenend@resvfn
    \def\evenend@rf##1##2{\ifnum##1=\evenend@c\relax\else\noexpand\evenend@rf{##1}{##2}\fi}%
    \xdef\evenend@resvfn{\evenend@resvfn}%
    \def\evenend@rv##1##2##3{\ifnum##1=\evenend@c\relax\else
      \noexpand\evenend@rv{##1}{##2}{##3}\fi}%
    \xdef\evenend@resv{\evenend@resv}%
    \begingroup
      \let\reserved@b\@deferlist
      \global\let\@deferlist\@empty
      \let\@elt\@scolelt
      \reserved@b
    \endgroup
  \fi}
\def\evenend@resvfn{}       % spanfootnote=bottom：\evenend@rf{段}{左の段の脚注の高さ}
\newif\ifevenend@fnadj
\newcount\evenend@savefncount
\newskip\evenend@savefnskip
\newdimen\evenend@savefndimen
\def\evenend@fnadjust#1{%
  \ifevenend@fnadj\else
    \global\evenend@savefncount\count\footins
    \global\evenend@savefnskip\skip\footins
    \global\evenend@savefndimen\dimen\footins
  \fi
  \global\evenend@fnadjtrue
  \global\count\footins\z@
  \global\skip\footins\z@
  \global\dimen\footins\dimexpr#1-\evenend@savefnskip\relax
  \ifdim\dimen\footins<\z@ \global\dimen\footins\z@ \fi}
\def\evenend@fnrestore{%
  \ifevenend@fnadj
    \global\count\footins\evenend@savefncount
    \global\skip\footins\evenend@savefnskip
    \global\dimen\footins\evenend@savefndimen
    \global\evenend@fnadjfalse
  \fi}
\def\evenend@placeholder#1#2{%
  \@next\@currbox\@freelist{%
    \global\setbox\@currbox\vbox to#2{\vss}%
    \global\count\@currbox\z@
    \directlua{evenend.markph(\number\@currbox)}%
    \expandafter\gdef\csname evenend@ph@\number\@currbox\endcsname{}%
    \if#1t\@flupdates\@topnum\@toproom\@toplist
    \else\@flupdates\@botnum\@botroom\@botlist\fi
  }{\@fltovf}}
%% 段を出力するとき（\@makecolの前）：段をまたぐフロートと場所取りを，上なら最初，
%% 下なら最後に並べ直し，段をまたぐフロートの右の段に場所取りを予約する．
%% この段のフロートの箱は出力の後に空くので，記録を消す
\def\evenend@spanprep{%
  %% spanfootnote=bottom：脚注を場所取りの中に収めた段は，脚注の分だけ場所取りを縮める
  \ifevenend@fnadj
    \evenend@fnrestore
    \ifvoid\footins\else
      \def\@elt##1{\ifcsname evenend@ph@\number##1\endcsname
        \global\ht##1\dimexpr\ht##1-\skip\footins-\ht\footins-\dp\footins\relax\fi}%
      \@botlist
      \let\@elt\relax
    \fi
  \fi
  %% 段間罫のために，上・下のフロートの数を数える
  \global\evenend@nt\z@ \global\evenend@nb\z@
  \def\@elt##1{\global\advance\evenend@nt\@ne}\@toplist
  \def\@elt##1{\global\advance\evenend@nb\@ne}\@botlist
  \global\evenend@phtop\z@ \global\evenend@phbot\z@
  \def\@elt##1{\ifcsname evenend@ph@\number##1\endcsname
    \global\evenend@phtop\dimexpr\ht##1+\dp##1\relax\fi}\@toplist
  \def\@elt##1{\ifcsname evenend@ph@\number##1\endcsname
    \global\evenend@phbot\dimexpr\ht##1+\dp##1\relax\fi}\@botlist
  \global\evenend@spanbotfalse
  \def\@elt##1{\evenend@ifspan##1{\global\evenend@spanbottrue}{}}\@botlist
  \def\@elt##1{\evenend@ifspan##1%
    {\g@addto@macro\evenend@a{\@elt##1}}{\g@addto@macro\evenend@b{\@elt##1}}}%
  \global\let\evenend@a\@empty \global\let\evenend@b\@empty
  \@toplist
  \let\@elt\relax
  \xdef\@toplist{\evenend@a\evenend@b}%
  \def\@elt##1{\evenend@ifspan##1%
    {\g@addto@macro\evenend@a{\@elt##1}}{\g@addto@macro\evenend@b{\@elt##1}}}%
  \global\let\evenend@a\@empty \global\let\evenend@b\@empty
  \@botlist
  \let\@elt\relax
  \xdef\@botlist{\evenend@b\evenend@a}%
  \def\@elt##1{\evenend@addresv##1t}\@toplist
  \def\@elt##1{\evenend@addresv##1b}\@botlist
  \let\@elt\relax}
%% 箱#1が段をまたぐフロートならその段数，場所取りなら-1，ほかは0（Lua側に渡す．
%% gyoudoriなどが箱を組み直すと箱の属性は消えるので，記録から渡す）
\def\evenend@spankof#1{%
  \ifcsname evenend@span@\number#1\endcsname \evenend@spankeff#1
  \else\ifcsname evenend@ph@\number#1\endcsname -1\else 0\fi\fi}
\def\evenend@addresv#1#2{%
  \ifcsname evenend@span@\number#1\endcsname
    %% spanfootnote=bottom：下に置いた図の右の段の場所取りは，この段の脚注の分も含める
    %% （右の段の脚注は，その中の下に収める）
    \dimen@\z@
    \ifevenend@sfb \if#2b\ifvoid\footins\else
      \dimen@\dimexpr\skip\footins+\ht\footins+\dp\footins\relax
    \fi\fi\fi
    \@tempcnta\@ne
    \@whilenum\@tempcnta<\evenend@spankeff#1\relax\do{%
      \xdef\evenend@resv{\unexpanded\expandafter{\evenend@resv}%
        \noexpand\evenend@rv{\the\numexpr\evenend@colno+\@ne+\@tempcnta\relax}{#2}%
          {\the\dimexpr\ht#1+\dp#1+\dimen@\relax}}%
      \ifevenend@sfb \if#2b%
        \xdef\evenend@resvfn{\unexpanded\expandafter{\evenend@resvfn}%
          \noexpand\evenend@rf{\the\numexpr\evenend@colno+\@ne+\@tempcnta\relax}{\the\dimen@}}%
      \fi\fi
      \advance\@tempcnta\@ne}%
  \fi}
%% 下に段をまたぐフロートがある段では，脚注をフロートの上に置く（またがる段の
%% あいだでフロートの位置がそろうように）．段の中の積み順はソケット
%% build/column/outputboxで決まるので，その段を組むあいだだけプラグを換える．
%% このソケット（と\socket_if_exist:n）のないLaTeX（2024-11-01など）の\@makecolは，
%% 本文，脚注，下のフロートの順に積むので，プラグを換えずにそのまま組む
%% （脚注はフロートの上．spanfootnote=bottomは，evenendが組み直す段だけに効く）
\ExplSyntaxOn
\cs_if_exist:NTF \socket_if_exist_p:n
  {
    \cs_new_protected:Npn \evenend@fnabovespan #1
      {
        \bool_lazy_and:nnTF
          { \legacy_if_p:n { evenend@spanbot } }
          { \socket_if_exist_p:n { build/column/outputbox } }
          {
            \str_set_eq:Nc \l_tmpa_str { l__socket_build/column/outputbox_plug_str }
            \legacy_if:nTF { evenend@sfb }
              { \str_set:Nn \l_tmpb_str { space-floats-footnotes } }
              { \str_set:Nn \l_tmpb_str { space-footnotes-floats } }
            \socket_assign_plug:nV { build/column/outputbox } \l_tmpb_str
            #1
            \socket_assign_plug:nV { build/column/outputbox } \l_tmpa_str
          }
          {#1}
      }
    \cs_generate_variant:Nn \socket_assign_plug:nn { nV }
  }
  { \cs_new_protected:Npn \evenend@fnabovespan #1 {#1} }
\ExplSyntaxOff
\def\evenend@spanclear#1{%
  \expandafter\global\expandafter\let\csname evenend@span@\number#1\endcsname\@undefined
  \expandafter\global\expandafter\let\csname evenend@ph@\number#1\endcsname\@undefined}

%% ---------------------------------------------------------------------
%% 柱（マーク）：段組のモードでは，ページを出力するときに，ページの本文全体から
%% 読む順序でマークを集め，1段組と同じ方法で柱の情報を更新する（揃えた段や積んだ
%% ブロックでは，マークが入れ子の箱の中にあり，段ごとの更新では正しくならない）
\newbox\evenend@markbox
\AtBeginDocument{%
  \ifdefined\@expl@@@mark@update@dblcol@structures@@
    \let\@expl@@@mark@update@dblcol@structures@@\relax
    %% \@outputpageの先頭で更新する（LaTeX 2025-06-01以降のフックbuild/page/beforeと
    %% 同じ位置．フックのない版でも動くように，\@outputpageの前に足す）
    \let\evenend@orig@outputpage\@outputpage
    \def\@outputpage{%
      \if@twocolumn
        \directlua{evenend.collectmarks(\number\@outputbox, \number\evenend@markbox)}%
        \evenend@legacymarks
        \begingroup
          \setbox\@outputbox\box\evenend@markbox
          \@expl@@@mark@update@singlecol@structures@@
        \endgroup
      \fi
      \evenend@orig@outputpage}%
  \fi}
%% LaTeX 2025-06-01より前の版では，\leftmark，\rightmarkはTeXのマーク（\firstmark，
%% \botmark）を使い，2段組では\@outputdblcolが1段目のマークを補う．evenendは
%% \@outputdblcolを置き換えるので，ページ全体から集めたマークの最初と最後を
%% \vsplitで取り出し，\firstmark，\botmark，\topmarkの代わりにする（マークのない
%% ページでは前のページの最後のマーク）
\def\evenend@lastbot{}
\let\evenend@legacymarks\relax
\AtBeginDocument{%
  \ifdefined\evenend@orig@outputpage
    \IfFormatAtLeastTF{2025-06-01}{}{\let\evenend@legacymarks\evenend@legacymarks@}%
  \fi}
\def\evenend@legacymarks@{%
  \begingroup
    \splitmaxdepth\maxdimen \vbadness\maxdimen \vfuzz\maxdimen
    \setbox\@tempboxa\copy\evenend@markbox
    \setbox\@tempboxa\vsplit\@tempboxa to\maxdimen
    \toks@\expandafter{\splitfirstmark}\xdef\evenend@sfm{\the\toks@}%
    \toks@\expandafter{\splitbotmark}\xdef\evenend@sbm{\the\toks@}%
  \endgroup
  \let\topmark\evenend@lastbot
  \ifx\evenend@sfm\@empty
    \let\firstmark\evenend@lastbot
    \let\botmark\evenend@lastbot
  \else
    \let\firstmark\evenend@sfm
    \let\botmark\evenend@sbm
    \global\let\evenend@lastbot\evenend@sbm
  \fi}

%% ---------------------------------------------------------------------
%% 段組の環境：evenendmulticols（常に定義）と，multicolを読み込んでいなければ
%% multicols，multicols*，\columnbreak．
%% ・ページの本文（主垂直リスト）では，\evenendcolumnsで段数を切り換える（段組の
%%   モードで使う．1段組の文書では，クラスオプションtwocolumnとcolumns=1で読み込む）
%% ・箱の中（tcolorbox，minipage，フロートなど．内部垂直モード）では，中身を段幅で
%%   組んでからLua側でN段に分けて揃え，1つの箱にする
\newif\ifevenend@inmc
\newif\ifevenend@mcbal % 段組（multicols環境）をmulticolと同じ方法で揃える
\newbox\evenend@boxcontent
\newbox\evenend@boxout
\newdimen\evenend@boxtop    % 箱の段組の上端から1行目のベースラインまで
\newdimen\evenend@boxcw
\newdimen\evenend@boxlw     % 箱の中の行長（段組の全幅）
\newdimen\evenend@boxfirst  % 各段の1行目の高さの最大値
%% \begin{evenendmulticols}[キー=値]{段数}[前置き]
\NewDocumentEnvironment{evenendmulticols}{O{} m o}
  {\evenend@mc@begin{#1}{#2}{#3}}{\evenend@mc@end{}}
\AtBeginDocument{%
  \@ifpackageloaded{multicol}{}{%
    %% \begin{multicols}{段数}[前置き][前置きの前のアキ（使わない）]
    \NewDocumentEnvironment{multicols}{m o o}
      {\evenend@mc@begin{}{#1}{#2}}{\evenend@mc@end{}}%
    \NewDocumentEnvironment{multicols*}{m o o}
      {\evenend@mc@begin{}{#1}{#2}}{\evenend@mc@end{*}}%
    %% \columnbreak：そこで段を改め，段の残りは空ける．段落の途中では，その行の
    %% 後で改める（multicolと同じく段落を終えない）
    \providecommand\columnbreak{%
      \ifvmode
        \penalty-\@M
      \else
        \@bsphack\vadjust{\penalty-\@M}\@esphack
      \fi}%
    %% multicolと同じく，段組の中の行分けは\multicoltolerance，\multicolpretolerance
    %% （既定は9999と-1）で行う
    \ifdefined\multicolsep\else
      \newskip\multicolsep \multicolsep=12pt plus 4pt minus 3pt
    \fi
    \ifdefined\premulticols\else
      \newdimen\premulticols \premulticols=50pt
    \fi
    \newcount\multicoltolerance \multicoltolerance=9999
    \newcount\multicolpretolerance \multicolpretolerance=-1
    %% \emergencystretchも，multicolと同じく段数×4pt（\setemergencystretch{段数}{段幅}）
    \providecommand\setemergencystretch[2]{%
      \emergencystretch 4pt \multiply\emergencystretch#1\relax}%
    %% \flushcolumns，\raggedcolumns（multicolと同じ）：段組の段を，段の高さまで伸ばして
    %% 下端をそろえるか，伸ばさずに自然な高さで組むか．揃えるページ（環境の終わり）と，
    %% 環境の途中の満ページの両方に効く．どちらも使わなければ，満ページはクラスの
    %% 設定（\flushbottom，\raggedbottom）に従い，揃えるページは段を伸ばす
    \def\flushcolumns{\@bsphack\evenend@mcshrink\tw@\evenend@mcsetbottom\@esphack}%
    \def\raggedcolumns{\@bsphack\evenend@mcshrink\@ne\evenend@mcsetbottom\@esphack}%
    %% tcolorboxなどは\columnbreakがあるとmulticolがあるとみなし，multicolの
    %% \doublecol@numberを見るので，0（multicolの段組の中ではない）で用意する
    \ifdefined\doublecol@number\else \newcount\doublecol@number \fi
  }}
%% \flushcolumns，\raggedcolumnsの状態（0：指定なし，1：\raggedcolumns，2：\flushcolumns）．
%% multicolと同じく，環境の中で変えれば，その環境の終わりまで効く
\newcount\evenend@mcshrink
%% ページの本文のmulticols環境の中では，満ページの段の下端の扱い（\@textbottom）も変える
\def\evenend@mcsetbottom{%
  \ifevenend@inmc
    \ifcase\evenend@mcshrink
    \or \def\@textbottom{\vskip\z@\@plus.0001fil}%
    \or \let\@textbottom\relax
    \fi
  \fi}
%% multicols環境の前のアキ（multicolと同じ）：\addvspace\multicolsep（前のアキが大きければ
%% それ）．前が行なら，さらに1行目のベースラインが前の行から行送りの倍数の位置に
%% 来るようにカーンを入れる．段組の上端（1行目の\topskipの上）までのアキとして渡す
\def\evenend@mc@gap{%
  \@tempskipa\multicolsep
  \ifnum\directlua{tex.sprint(evenend.curlistempty() and 1 or 0)}=\@ne
    %% 今のリストが空（前のアキはページに移っている．\lastskipなどはページの最後の
    %% 要素を指す）：multicolの\addvspaceと同じく，ページの末尾がグルーならそれと
    %% \multicolsepの大きいほう，ペナルティ（\nobreakなど）なら，その前のグルーに
    %% \multicolsepを足す（このアキは1段の段組の末尾として捨てられるので，ここで数える）
    \advance\@tempskipa\directlua{tex.sprint(evenend.pagetailskip(\number\@tempskipa) .. 'sp')}\relax
  \else
    %% 前のアキの後に\nobreakがあると\lastskipが見えないので，いったん外して読み，戻す
    \@tempswafalse
    \ifnum\lastpenalty=\@M \unpenalty \@tempswatrue \fi
    \ifdim\lastskip>\@tempskipa \@tempskipa\lastskip \fi
    \if@tempswa \nobreak \fi
  \fi
  \ifdim\prevdepth=-\@m\p@
    \@tempdima\@tempskipa
  \else
    \@tempcnta\prevdepth \@tempcntb\baselineskip
    \divide\@tempcnta\@tempcntb \advance\@tempcnta\@ne
    \@tempdima\dimexpr\@tempskipa+\@tempcnta\baselineskip-\prevdepth-\topskip\relax
  \fi
  \ifevenend@debug\typeout{evenend: mc gap \the\@tempdima}\fi
  \evenendsetup{blockgap=\the\@tempdima}}
%% #1：キー（columnsep，columnseprule），#2：段数，#3：前置き
\def\evenend@mc@begin#1#2#3{%
  \par
  \tolerance\multicoltolerance
  \pretolerance\multicolpretolerance
  \setemergencystretch{\numexpr#2\relax}\hsize
  \ifinner\else \ifdefined\multicolsep
    \evenend@mc@gap
  \fi \fi
  \ifinner
    \let\evenend@mc@end\evenend@box@end
    \evenend@box@begin{#1}{#2}{#3}%
  \else
    \let\evenend@mc@end\evenend@page@end
    \ifevenend@inmc
      \PackageError{evenend}{Nested multicols is not supported}{}%
    \fi
    \global\evenend@inmctrue
    \evenend@mcsetbottom
    %% 環境の後は，環境の前の段組の段数・段間・段間罫に戻す
    \xdef\evenend@mc@savedN{\the\evenend@N}%
    \xdef\evenend@mc@saved{[columnsep=\the\evenend@colsep,
      columnseprule=\the\evenend@colrule]{\the\evenend@N}}%
    \IfValueT{#3}{\evenendcolumns{1}#3\par}%
    \ifdefined\premulticols \xdef\evenend@mcpremin{\the\premulticols}\fi
    \evenendcolumns[#1]{#2}%
    \global\let\evenend@mcpremin\@empty
  \fi}
\def\evenend@page@end#1{%
  \par
  %% multicolと同じく，段組の後は\multicolsepを空け，次の行のベースラインを段組の
  %% 下端から\multicolsep＋\baselineskipの位置に置く．段組はmulticolと同じ方法で揃える
  \ifdefined\multicolsep
    \ifnum\evenend@mc@savedN=\@ne
      %% 1段に戻る：段組の直後に目印（空の箱）を置く．後のグルー（\vfillなど）を
      %% 捨てさせず，目印の後の行は\baselineskipで置かれる（multicolの\prevdepth=0と同じ）．
      %% 段組の後のアキ\multicolsepは目印の後に本当のグルーとして置く（後の\addvspaceと
      %% 大きいほうにまとまるように）．段組の間のアキは目印の\topskipを打ち消すだけ
      \evenendsetup{blockgap=\the\dimexpr-\topskip\relax}%
    \else
      \evenendsetup{blockgap=\the\dimexpr\multicolsep+\baselineskip-\topskip\relax}%
    \fi
    \global\evenend@mcbaltrue
  \fi
  \edef\evenend@tmp{\noexpand\evenendcolumns#1\evenend@mc@saved}%
  \evenend@tmp
  %% 目印は，終えた段組がこのページに積まれているときだけ置く（段組の終わりで改ページ
  %% したなら，後のアキは次のページの頭でTeXが捨てるのと同じく，何も置かない）
  \ifdefined\multicolsep \ifnum\evenend@mc@savedN=\@ne \ifvoid\evenend@pagetop\else
    {\evenend@markattr\@ne \nointerlineskip\vbox{}}%
    \vskip\multicolsep
  \fi\fi\fi
  \global\evenend@inmcfalse}

%% 箱の中の段組
\def\evenend@box@begin#1#2#3{%
  \IfValueT{#3}{#3\par}%
  %% multicolと同じく，前後に\multicolsepを空ける
  \ifdefined\multicolsep \addvspace\multicolsep \fi
  \global\evenend@nextN=\numexpr#2\relax
  \ifnum\evenend@nextN<\@ne \global\evenend@nextN\@ne \fi
  \global\evenend@nextsep\columnsep
  \global\evenend@nextrule\columnseprule
  \SetKeys[evenend/block]{#1}%
  \edef\evenend@box@N{\the\evenend@nextN}%
  \edef\evenend@box@sep{\the\evenend@nextsep}%
  \edef\evenend@box@rule{\the\evenend@nextrule}%
  \evenend@boxcw\linewidth
  \ifdim\evenend@boxcw>\hsize \evenend@boxcw\hsize \fi
  \evenend@boxlw\evenend@boxcw
  \advance\evenend@boxcw-\numexpr\evenend@box@N-\@ne\relax\dimexpr\evenend@box@sep\relax
  \divide\evenend@boxcw\evenend@box@N\relax
  \setbox\evenend@boxcontent\vbox\bgroup
    \hsize\evenend@boxcw \linewidth\hsize \columnwidth\hsize
    \@totalleftmargin\z@
    %% 箱の脚注（minipageの脚注）は，段幅ではなく箱の行長で組む
    %% （minipageの中では\@footnotetextが\@mpfootnotetextと同じもの）
    \ifx\@footnotetext\@mpfootnotetext
      \let\evenend@mpfootnotetext\@mpfootnotetext
      \long\def\@footnotetext##1{%
        \begingroup
          \columnwidth\evenend@boxlw
          \evenend@mpfootnotetext{##1}%
        \endgroup}%
    \fi
    \let\evenend@mc@begin\evenend@nested}
\def\evenend@nested#1#2#3{%
  \PackageError{evenend}{Nested multicols is not supported}{}%
  \let\evenend@mc@end\@gobble}
\newcount\evenend@boxmc
\def\evenend@box@end#1{%
    \par
  \egroup
  \begingroup
    \splittopskip\topskip
    \splitmaxdepth\maxdepth
    \vbadness\@M \vfuzz\maxdimen
    \directlua{evenend.boxbalance{
      N       = \evenend@box@N,
      content = \number\evenend@boxcontent,
      out     = \number\evenend@boxout,
      scratch = \number\evenend@scratch,
      cw      = \number\evenend@boxcw,
      sep     = \number\dimexpr\evenend@box@sep\relax,
      rule    = \number\dimexpr\evenend@box@rule\relax,
      topskip = \number\topskip,
      blskip  = \number\baselineskip,
      mcbal   = \ifdefined\multicolsep true\else false\fi,
      mcragged = \ifnum\evenend@mcshrink=\@ne true\else false\fi,
    }}%
  \endgroup
  \ifnum\evenend@boxmc=\@ne
    \expandafter\evenend@box@placemc
  \else
    \expandafter\evenend@box@place
  \fi}
%% multicolと同じ置き方：前が行なら1行目のベースラインが前の行から行送りの倍数の
%% 位置に来るカーン，段組の箱（深さは「p」の深さ以上），\prevdepth=0，箱の深さだけ戻す
\def\evenend@box@placemc{%
  \global\evenend@boxmc\z@
  \ifdim\prevdepth=-\@m\p@\else
    \@tempcnta\prevdepth \@tempcntb\baselineskip
    \divide\@tempcnta\@tempcntb \advance\@tempcnta\@ne
    \kern\dimexpr\@tempcnta\baselineskip-\prevdepth-\topskip\relax
  \fi
  \setbox\z@\hbox{p}%
  \ifdim\dp\evenend@boxout<\dp\z@ \dp\evenend@boxout\dp\z@ \fi
  %% multicolと同じく，「p」と段の深さの大きいほうだけ戻す
  \@tempdima\dp\evenend@boxout
  \nointerlineskip
  \box\evenend@boxout
  \prevdepth\z@
  \kern-\@tempdima
  \addvspace\multicolsep \prevdepth\z@}
\def\evenend@box@place{%
  \ifvoid\evenend@boxout\else
    %% 前の行からのベースライン間を\baselineskipにする（箱の先頭では詰めて置く）
    \ifdim\prevdepth>-1000\p@
      \vskip\dimexpr\baselineskip-\prevdepth-\evenend@boxtop\relax
      \nointerlineskip
    \else
      %% 箱などの先頭：1行目の上端を箱の上端に合わせる（通常の1行目と同じ）
      \nointerlineskip
      \kern-\dimexpr\evenend@boxtop-\evenend@boxfirst\relax
    \fi
    %% multicolと同じく，段組の箱の深さ（最終行の深さ）は数えない
    \ifdefined\multicolsep \dp\evenend@boxout\z@ \fi
    \box\evenend@boxout
  \fi
  \ifdefined\multicolsep \addvspace\multicolsep \prevdepth\z@ \fi}

%% ---------------------------------------------------------------------
%% ページが空か：ページの材料（\pagetotal）がなく，積んだ段組（ブロック）もない．
%% evenendでは，段数を切り換えるとそれまでの段組をページの上部に積むので，
%% \pagetotalだけではページが空かどうかはわからない
\newcommand\evenendifpageempty[2]{%
  \ifdim\pagetotal>\z@ #2\else\ifvoid\evenend@pagetop #1\else #2\fi\fi}
%% 改段（\newpage）．積んだ段組だけのページでも改める（空の箱を置いて出力させる．
%% 空の箱はLua側で捨てる）
\newcommand\evenendnewpage{%
  \par
  \ifdim\pagetotal>\z@
    \newpage
  \else\ifvoid\evenend@pagetop\else
    \nointerlineskip\vbox{}\newpage
  \fi\fi}

%% ---------------------------------------------------------------------
%% 分割できる箱の分割位置の受け渡し
%% tcolorboxの箱にキーevenend breakableを付けると，揃えるページでその箱の段の
%% 下端が揃う分割位置（部分ごとの高さ）をLua側で求めて.auxに書き，次の組版で
%% tcolorboxのbreak atに渡す．分割位置が前の組版と変わったときは，再実行を促す．
%% （LaTeXが最初に組んだときの分割の位置は，段を割り振り直しても動かせないため）
\newcount\evenend@boxcnt
\def\evenend@boxbreak#1#2{\global\@namedef{evenend@boxbreak@#1}{#2}}
%% 箱を分けないとき，tcolorboxは箱を局所的な設定の外で組むので，属性は大域的に
%% 付け，箱を置いた後に外す（tcolorboxの箱の後に入れる\kvtcb@afterboxの末尾に
%% 足す．afterのキーはほかの設定を置き換えるので使わない）
\def\evenend@tcbbreakable{%
  \global\advance\evenend@boxcnt\@ne
  \global\evenend@boxattr=\evenend@boxcnt
  \ifdefined\kvtcb@afterbox\else\let\kvtcb@afterbox\@empty\fi
  \expandafter\def\expandafter\kvtcb@afterbox\expandafter{%
    \kvtcb@afterbox\global\evenend@boxattr=-"7FFFFFFF\relax}%
  \ifcsname evenend@boxbreak@\the\evenend@boxcnt\endcsname
    \edef\evenend@tmp{\noexpand\pgfkeysalso{/tcb/break at=%
      \csname evenend@boxbreak@\the\evenend@boxcnt\endcsname}}%
    \evenend@tmp
  \fi}
%% evenend min first=<寸法>：箱の最初の部分の最小の高さ．段の境目で最初の部分が
%% これより低くなるなら，箱を分けずに次の段へ送る（evenend breakableの後に書く）
\AtBeginDocument{%
  \@ifpackageloaded{tcolorbox}%
    {\tcbset{evenend breakable/.code={\evenend@tcbbreakable},
      evenend min first/.code={%
        \expandafter\xdef\csname evenend@boxmin@\the\evenend@boxcnt\endcsname
          {\the\dimexpr#1\relax}}}}{}}
%% Lua側から呼ぶ：分割位置を.auxに書く
\def\evenend@writeboxbreak#1#2{%
  \if@filesw
    \immediate\write\@auxout{\string\evenend@boxbreak{#1}{#2}}%
  \fi}

\endinput
